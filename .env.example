DATABASE_URL=postgres://user:password@host:5432/database
DATABASE_SSL=require
# Comma-separated public origins allowed to call the API from browser pages.
PUBLIC_FORM_ORIGIN=https://fungalaxy.be,https://www.fungalaxy.be,https://www.mngfunglxy.com,https://mngfunglxy.com

# Secrets required in production. Generate long random values and never reuse demo values.
SITE_USERNAME=staff
STAFF_AUTH_SECRET=replace-with-random-64-character-secret
STAFF_DIRECTION_CODE=replace-with-private-direction-code
PLATFORM_OWNER_CODE=replace-with-private-owner-code
CRON_SECRET=replace-with-random-64-character-secret
ALLOW_INSECURE_STAFF_CODES=false
# Legacy only. Do not use SITE_PASSWORD in production.
SITE_PASSWORD=

# Email dispatch. Without RESEND_API_KEY, queued emails stay retryable and are not sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev
STAFF_REVIEW_EMAIL=staff@example.com

# Ops workers and cron endpoints must be protected with CRON_SECRET.
OPS_WORKER_COMMUNICATION_INTERVAL_MS=60000
OPS_WORKER_COMMUNICATION_LIMIT=50
OPS_WORKER_AGENT_INTERVAL_MS=900000
OPS_WORKER_AGENT_DAYS=30
OPS_WORKER_RUN_COMMUNICATIONS=true
OPS_WORKER_RUN_AGENTS=true

# Optional AI/marketing providers.
OPENAI_API_KEY=
OPENAI_MARKETING_MODEL=gpt-4.1-mini
META_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
MARKETING_SOCIAL_SIGNALS_JSON=[]

# Optional SMS provider. Leave empty until the sender is configured and approved.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
