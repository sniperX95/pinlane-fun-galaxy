DATABASE_URL=postgres://user:password@host:5432/database
DATABASE_SSL=require
# Comma-separated public origins allowed to call the API from browser pages.
PUBLIC_FORM_ORIGIN=https://fungalaxy.be,https://www.fungalaxy.be,https://www.mngfunglxy.com,https://mngfunglxy.com

# Secrets required in production. Generate long random values and never reuse demo values.
SITE_USERNAME=staff
# Signs sessions and verifies EVERY access code of every client. Changing or
# removing it invalidates all codes and sessions. There is no fallback.
STAFF_AUTH_SECRET=replace-with-random-64-character-secret
# Platform owner master key (all centers of all clients). There is no fallback.
# Direction and team codes are managed per center in the console: no
# environment variable carries them (STAFF_DIRECTION_CODE is no longer read).
PLATFORM_OWNER_CODE=replace-with-private-owner-code
CRON_SECRET=replace-with-random-64-character-secret
# Dev-only opt-in for demo staff codes. Fallbacks are OFF unless this is
# exactly "true"; leave unset/false everywhere except local development.
ALLOW_INSECURE_STAFF_CODES=false
# Browser sign-in window in front of internal pages (middleware.ts). No staff
# code and no secret falls back to it.
SITE_PASSWORD=

# Email dispatch. Without RESEND_API_KEY, queued emails stay retryable and are not sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev
STAFF_REVIEW_EMAIL=staff@example.com

# Retrait de la liste marketing (lien de desinscription des mails MARKETING).
# Sert a calculer une empreinte deterministe HMAC-SHA256 tronquee a 128 bits :
# la meme adresse chez le meme centre donne toujours le meme lien, sans avoir
# a provisionner de jeton a l'avance. 32 caracteres MINIMUM, sinon le secret
# est ignore. Absent ou trop court : le lien fonctionne quand meme (le jeton
# est stocke a l'envoi), il tire simplement 128 bits aleatoires par message et
# perd sa stabilite. Ne jamais reutiliser un autre secret ici.
UNSUBSCRIBE_SECRET=replace-with-random-64-character-secret

# Ops workers and cron endpoints must be protected with CRON_SECRET.
OPS_WORKER_COMMUNICATION_INTERVAL_MS=60000
OPS_WORKER_COMMUNICATION_LIMIT=50
OPS_WORKER_AGENT_INTERVAL_MS=900000
OPS_WORKER_AGENT_DAYS=30
OPS_WORKER_RUN_COMMUNICATIONS=true
OPS_WORKER_RUN_AGENTS=true

# Fournisseurs de modele. ORDRE REEL, lu dans lib/llm-client.js (llmProvider) :
#   LLM_PROVIDER force le choix, puis Kimi, puis Anthropic, puis OpenAI, puis
#   OpenRouter. Kimi passe AVANT Anthropic : le laisser en dernier reviendrait a
#   ne jamais utiliser la cle que le centre paie.
# OpenRouter n est ouvert QU AUX usages sans donnee client (marketing, content,
# competitor). Un appel non declare est traite comme sensible, donc il lui faut
# une des trois autres cles. Sans aucune d elles, l agent marketing ne parle
# pas, et il le dit maintenant au lieu de ressembler a un centre sans matiere.
LLM_PROVIDER=
KIMI_API_KEY=
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MARKETING_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MARKETING_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Plafond mensuel de depense modele, en dollars. Defaut 5 si absent ou nul.
LLM_MONTHLY_BUDGET_USD=
META_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
MARKETING_SOCIAL_SIGNALS_JSON=[]

# Optional SMS provider. Leave empty until the sender is configured and approved.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
